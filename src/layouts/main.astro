---
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Mill Creek Farm Perennials - Your trusted partner for quality perennial plants and nursery services in West Michigan." />
	</head>
	<body class="antialiased">
		<SmoothScroll client:load>
			<slot />
		</SmoothScroll>
		
		<script>
			// Scroll to top on page refresh/reload
			window.addEventListener('beforeunload', function() {
				window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
			});
			
			// Also scroll to top when the page loads
			window.addEventListener('load', function() {
				window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
			});
		</script>
	</body>
</html>
