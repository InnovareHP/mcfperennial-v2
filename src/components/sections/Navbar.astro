---
// Navbar Section Component
---

<nav id="navbar" class="fixed top-0 w-full bg-transparent z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-22 md:h-22 lg:h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="#" id="logo-link" class="flex items-center focus:outline-none">
          <!-- Mobile/Tablet Logo (visible on mobile and tablet) -->
          <img id="navbar-logo-mobile" src="/images/logos/mobile-logo.png" alt="Company Logo" class="h-[70px] md:h-[70px] lg:hidden w-auto transition-all duration-150" />
          <!-- Desktop Logo (visible on desktop) -->
          <img id="navbar-logo-desktop" src="/images/logos/logo-light.png" alt="Company Logo" class="hidden lg:block h-16 xl:h-20 w-auto transition-all duration-150" />
        </a>
      </div>
      
      <!-- Navigation Links -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-2">
          <a href="#hero" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Home</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#about" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">About</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#featured" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Featured</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#seasonal" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Seasonal</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#contract" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Contract</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#team" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Team</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
          <a href="#contact" class="nav-link text-white hover:text-fresh-green px-6 py-3 text-base font-medium transition-all duration-300 relative group cursor-pointer">
            <span class="relative z-10">Contact</span>
            <div class="absolute inset-0 bg-fresh-green/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-0 h-0.5 bg-fresh-green transition-all duration-300 group-hover:w-8"></div>
          </a>
        </div>
      </div>
      
      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button 
          id="mobile-menu-button" 
          type="button" 
          class="text-white hover:text-fresh-green focus:outline-none focus:text-fresh-green transition-colors duration-300 p-2 rounded-lg hover:bg-white/10 focus:bg-white/10 active:bg-white/20 touch-manipulation cursor-pointer"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="h-7 w-7 transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-7 w-7 hidden transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile menu - Full Screen with Green Gradient -->
    <div id="mobile-menu" class="md:hidden hidden fixed inset-0 z-50 mobile-menu-overlay">
      <!-- Green Gradient Background -->
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-600 via-green-600 to-teal-700"></div>
      
      <!-- Content Container -->
      <div class="relative h-full flex flex-col px-8 pt-8 pb-8">
        <!-- Header with Logo and Close Button -->
        <div class="flex items-center justify-between mb-12">
          <!-- Empty space for alignment -->
          <div class="w-10"></div>
          
          <!-- Logo Center -->
          <div class="flex-1 flex justify-center">
            <img 
              src="/images/logos/logo-light.png" 
              alt="Mill Creek Farm Perennials Logo" 
              class="h-20 w-auto"
            />
          </div>
          
          <!-- Close Button -->
          <button 
            id="mobile-menu-close" 
            type="button" 
            class="text-white hover:text-white/80 focus:outline-none transition-all duration-300 p-2 rounded-full hover:bg-white/10 active:bg-white/20 cursor-pointer"
            aria-label="Close mobile menu"
          >
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <!-- Navigation Links -->
        <nav class="flex-1 flex flex-col justify-center space-y-2">
          <a href="#hero" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Home</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#about" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">About</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#featured" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Featured</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#seasonal" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Seasonal</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#contract" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Contract</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#team" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Team</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <div class="h-px bg-white/10"></div>
          
          <a href="#contact" class="mobile-nav-link group flex items-center justify-between px-6 py-4 text-white text-xl font-medium transition-all duration-300 cursor-pointer">
            <span class="relative">Contact</span>
            <svg class="w-6 h-6 text-white/60 group-hover:text-white group-hover:translate-x-2 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </nav>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu functionality
  function initMobileMenu() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    
    if (mobileMenuButton && mobileMenu) {
      // Function to show mobile menu
      function showMobileMenu() {
        mobileMenu.classList.remove('hidden');
        // Prevent body scroll when menu is open
        document.body.style.overflow = 'hidden';
        
        // Animate menu entrance
        setTimeout(() => {
          mobileMenu.classList.add('menu-open');
        }, 10);
        
        if (menuIcon) menuIcon.classList.add('hidden');
        if (closeIcon) closeIcon.classList.remove('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'true');
        
        // Animate menu items
        const menuItems = mobileMenu.querySelectorAll('.mobile-nav-link');
        menuItems.forEach((item, index) => {
          item.style.animation = `slideInLeft 0.5s ease-out ${index * 0.1}s forwards`;
        });
      }
      
      // Function to hide mobile menu
      function hideMobileMenu() {
        mobileMenu.classList.remove('menu-open');
        // Restore body scroll
        document.body.style.overflow = '';
        
        setTimeout(() => {
          mobileMenu.classList.add('hidden');
        }, 300);
        
        if (menuIcon) menuIcon.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
      }
      
      // Toggle mobile menu on button click
      mobileMenuButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const isHidden = mobileMenu.classList.contains('hidden');
        
        if (isHidden) {
          showMobileMenu();
        } else {
          hideMobileMenu();
        }
      });
      
      // Close button functionality
      if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          hideMobileMenu();
        });
      }
      
      // Close mobile menu when clicking on a link
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', function() {
          hideMobileMenu();
        });
      });
      
      // Close mobile menu on escape key
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          hideMobileMenu();
        }
      });
    }
  }
  
  // Navbar scroll effect and active section highlighting
  function handleNavbarScroll() {
    const navbar = document.getElementById('navbar');
    const navLinks = navbar.querySelectorAll('a[href^="#"]');
    const mobileButton = navbar.querySelector('#mobile-menu-button');
    const navbarLogoMobile = document.getElementById('navbar-logo-mobile');
    const navbarLogoDesktop = document.getElementById('navbar-logo-desktop');
    const scrolled = window.scrollY > 50;
    
    // Update active section based on scroll position
    updateActiveSection();
    
    if (scrolled) {
      // Add scrolled styles
      navbar.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-natural');
      navbar.classList.remove('bg-transparent');
      
      // Switch to regular logos when scrolled - keep mobile logo same size
      if (navbarLogoMobile) {
        navbarLogoMobile.src = '/images/logos/mobile-logo.png';
        // Keep mobile logo the same size when scrolled
        // No size changes for mobile/tablet logo
      }
      if (navbarLogoDesktop) {
        navbarLogoDesktop.src = '/images/logos/logo.png';
        // Make desktop logo larger when scrolled
        navbarLogoDesktop.classList.remove('h-16', 'xl:h-20');
        navbarLogoDesktop.classList.add('h-20', 'xl:h-24');
      }
      
      // Update navigation links for scrolled state
      navLinks.forEach(link => {
        link.classList.remove('text-white', 'hover:text-fresh-green', 'active:bg-fresh-green', 'active:text-white');
        link.classList.add('text-forest-dark', 'hover:text-fresh-green', 'active:bg-fresh-green', 'active:text-white');
      });
      
      // Update mobile button for scrolled state
      if (mobileButton) {
        mobileButton.classList.remove('text-white', 'hover:text-fresh-green');
        mobileButton.classList.add('text-forest-dark', 'hover:text-fresh-green');
      }
    } else {
      // Remove scrolled styles
      navbar.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-natural');
      navbar.classList.add('bg-transparent');
      
      // Switch to light logos when at top - keep mobile logo same size
      if (navbarLogoMobile) {
        navbarLogoMobile.src = '/images/logos/mobile-logo.png';
        // Keep mobile logo the same size when not scrolled
        // No size changes for mobile/tablet logo
      }
      if (navbarLogoDesktop) {
        navbarLogoDesktop.src = '/images/logos/logo-light.png';
        navbarLogoDesktop.classList.remove('h-20', 'xl:h-24');
        navbarLogoDesktop.classList.add('h-16', 'xl:h-20');
      }
      
      // Update navigation links for transparent state
      navLinks.forEach(link => {
        link.classList.remove('text-forest-dark', 'hover:text-fresh-green', 'active:bg-fresh-green', 'active:text-white');
        link.classList.add('text-white', 'hover:text-fresh-green', 'active:bg-fresh-green', 'active:text-white');
      });
      
      // Update mobile button for transparent state
      if (mobileButton) {
        mobileButton.classList.remove('text-forest-dark', 'hover:text-fresh-green');
        mobileButton.classList.add('text-white', 'hover:text-fresh-green');
      }
    }
  }

  // Function to update active section based on scroll position
  function updateActiveSection() {
    const sections = ['hero', 'about', 'featured', 'seasonal', 'contract', 'team', 'contact'];
    const navLinks = document.querySelectorAll('a[href^="#"]');
    
    // Remove active class from all links
    navLinks.forEach(link => {
      link.classList.remove('bg-fresh-green', 'text-white', 'shadow-lg', 'nav-active');
    });
    
    // Find the current section using Intersection Observer approach
    let currentSection = '';
    const scrollPosition = window.scrollY;
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    
    // Check if we're at the very bottom (for contact section)
    const isAtBottom = (scrollPosition + windowHeight) >= (documentHeight - 10);
    
    // If at bottom, highlight contact
    if (isAtBottom) {
      currentSection = 'contact';
    } else {
      // Check each section to see which one is most visible
      let bestSection = '';
      let bestVisibility = 0;
      
      for (const section of sections) {
        const element = document.getElementById(section);
        if (element) {
          const rect = element.getBoundingClientRect();
          const elementTop = rect.top;
          const elementBottom = rect.bottom;
          const elementHeight = rect.height;
          
          // Calculate how much of the section is visible
          let visibleHeight = 0;
          
          if (elementTop >= 0 && elementBottom <= windowHeight) {
            // Section is fully visible
            visibleHeight = elementHeight;
          } else if (elementTop < 0 && elementBottom > 0) {
            // Section is partially visible from top
            visibleHeight = elementBottom;
          } else if (elementTop < windowHeight && elementBottom > windowHeight) {
            // Section is partially visible from bottom
            visibleHeight = windowHeight - elementTop;
          } else if (elementTop >= 0 && elementTop < windowHeight) {
            // Section starts in viewport
            visibleHeight = Math.min(elementHeight, windowHeight - elementTop);
          }
          
          // Calculate visibility percentage
          const visibilityPercentage = visibleHeight / elementHeight;
          
          // If this section has better visibility, make it the current section
          if (visibilityPercentage > bestVisibility) {
            bestVisibility = visibilityPercentage;
            bestSection = section;
          }
          
          // Also check if section is in the top half of viewport (for better UX)
          if (elementTop <= windowHeight / 2 && elementBottom > 0) {
            currentSection = section;
          }
        }
      }
      
      // If no section is in the top half, use the best visible section
      if (!currentSection && bestSection) {
        currentSection = bestSection;
      }
    }
    
    // Fallback to hero if no section is found
    if (!currentSection) {
      currentSection = 'hero';
    }
    
    // Add active class to current section link
    const activeLink = document.querySelector(`a[href="#${currentSection}"]`);
    if (activeLink) {
      activeLink.classList.add('nav-active');
    }
  }

  // Handle responsive behavior
  function handleResponsive() {
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    
    // Close mobile menu on larger screens
    if (window.innerWidth >= 768) { // md breakpoint
      if (mobileMenu) {
        mobileMenu.classList.add('hidden');
        if (menuIcon) menuIcon.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        if (mobileMenuButton) mobileMenuButton.setAttribute('aria-expanded', 'false');
      }
    }
  }
  
  // Smooth scroll with offset for navigation links
  function initSmoothScroll() {
    const navLinks = document.querySelectorAll('a[href^="#"]');
    const logoLink = document.getElementById('logo-link');
    
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetId = this.getAttribute('href');
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          // 80px offset for all sections to account for navbar
          const offset = 80;
          const targetPosition = targetElement.offsetTop - offset;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
    
    // Logo click to scroll to top
    if (logoLink) {
      logoLink.addEventListener('click', function(e) {
        e.preventDefault();
        
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  }

  // Initialize everything
  function initNavbar() {
    initMobileMenu();
    handleNavbarScroll();
    handleResponsive();
    initSmoothScroll();
  }
  
  // Add event listeners
  window.addEventListener('scroll', handleNavbarScroll);
  window.addEventListener('resize', handleResponsive);
  
  // Initialize immediately
  initNavbar();
  
  // Also initialize on DOM ready as backup
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  }
</script>

<style>
  /* Modern navbar highlighting styles */
  .nav-link {
    position: relative;
    overflow: hidden;
  }
  
  .nav-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(34, 197, 94, 0.05) 100%);
    border-radius: 8px;
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #22c55e, #16a34a);
    border-radius: 1px;
    transform: translateX(-50%);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2;
  }
  
  .nav-link:hover::before {
    transform: scale(1);
  }
  
  .nav-link:hover::after {
    width: 32px;
  }
  
  .nav-link.nav-active::before {
    transform: scale(1);
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(34, 197, 94, 0.08) 100%);
  }
  
  .nav-link.nav-active::after {
    width: 32px;
    background: linear-gradient(90deg, #22c55e, #16a34a);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }
  
  .nav-link.nav-active {
    color: #22c55e !important;
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
  }
  
  /* Smooth transitions for all states */
  .nav-link span {
    position: relative;
    z-index: 3;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .nav-link:hover span {
    transform: translateY(-1px);
  }
  
  .nav-link.nav-active span {
    transform: translateY(-1px);
    font-weight: 600;
  }
  
  /* Mobile Menu Full Screen Styles */
  .mobile-menu-overlay {
    opacity: 0;
    transform: translateX(100%);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .mobile-menu-overlay.menu-open {
    opacity: 1;
    transform: translateX(0);
  }
  
  /* Mobile menu link animations */
  .mobile-nav-link {
    opacity: 0;
    transform: translateX(-30px);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  
  .mobile-nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .mobile-nav-link:hover::before,
  .mobile-nav-link:active::before {
    transform: scaleX(1);
  }
  
  .mobile-nav-link:active {
    transform: scale(0.98);
  }
  
  /* Slide in animation */
  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
