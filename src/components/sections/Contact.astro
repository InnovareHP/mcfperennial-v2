---
// Contact Us Section Component
import { MapPin, Phone, Facebook, Send } from 'lucide-react';
---

<section id="contact" class="py-20 bg-gradient-to-br from-sage-light to-cream-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-fresh-green mb-4 fade-in-slide-up">
        Contact
      </h2>
      <h3 class="text-4xl md:text-5xl font-bold text-forest-dark mb-8 fade-in-slide-up" style="animation-delay: 0.2s;">
        Get In Touch With Us
      </h3>
      <p class="text-xl text-forest-dark/80 max-w-3xl mx-auto fade-in-slide-up" style="animation-delay: 0.4s;">
        Ready to partner with us? We'd love to hear from you and discuss how we can support your business needs.
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12 items-stretch">
      <!-- Contact Information -->
      <div class="flex flex-col space-y-8 fade-in-slide-up" style="animation-delay: 0.6s;">
        <div class="bg-white rounded-lg shadow-lg p-8 border border-sage-light">
          <h4 class="text-2xl font-bold text-forest-dark mb-6">Contact Information</h4>
          
          <div class="space-y-6">
            <!-- Address -->
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-fresh-green/10 rounded-lg flex items-center justify-center">
                <MapPin class="w-6 h-6 text-fresh-green" />
              </div>
              <div>
                <h5 class="font-semibold text-forest-dark mb-1">Address</h5>
                <p class="text-forest-dark/80">4221 Bud Drive NE<br>Comstock Park, MI 49321</p>
              </div>
            </div>
            
            <!-- Phone -->
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-fresh-green/10 rounded-lg flex items-center justify-center">
                <Phone class="w-6 h-6 text-fresh-green" />
              </div>
              <div>
                <h5 class="font-semibold text-forest-dark mb-1">Phone</h5>
                 <a href="tel:+16168624331" class="text-fresh-green hover:text-forest-dark transition-colors cursor-pointer">
                   (616) 862-4331
                 </a>
              </div>
            </div>
            
            <!-- Facebook -->
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-fresh-green/10 rounded-lg flex items-center justify-center">
                <Facebook class="w-6 h-6 text-fresh-green" />
              </div>
              <div>
                <h5 class="font-semibold text-forest-dark mb-1">Follow Us</h5>
                <div class="space-y-2">
                   <a 
                     href="https://www.facebook.com/mcfperennials" 
                     target="_blank" 
                     rel="noopener noreferrer"
                     class="block text-fresh-green hover:text-forest-dark transition-colors cursor-pointer"
                   >
                     Facebook Page
                   </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Interactive Map -->
        <div class="bg-white rounded-lg shadow-lg p-8 border border-sage-light flex-1 flex flex-col">
          <h4 class="text-2xl font-bold text-forest-dark mb-6">Find Us</h4>
          <div class="rounded-lg overflow-hidden flex-1 min-h-[400px]">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2969.176683401312!2d-85.67022582385535!3d43.04100927113782!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8819abab04077685%3A0x1c443c1553cd1f52!2sMill%20Creek%20Farm%20Perennials!5e1!3m2!1sen!2sph!4v1760366341526!5m2!1sen!2sph" 
              width="100%" 
              height="400" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full"
            ></iframe>
          </div>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="fade-in-slide-up flex flex-col" style="animation-delay: 0.8s;">
        <div class="bg-white rounded-lg shadow-lg p-8 border border-sage-light flex-1 flex flex-col">
          <h4 class="text-2xl font-bold text-forest-dark mb-6">Send Us a Message</h4>
          <form class="space-y-6 flex-1 flex flex-col">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-forest-dark mb-2">First Name</label>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName"
                  class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-forest-dark mb-2">Last Name</label>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName"
                  class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors"
                  placeholder="Your last name"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-forest-dark mb-2">Email Address</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors"
                placeholder="your.email@example.com"
              />
            </div>
            
            <div>
              <label for="phone" class="block text-sm font-medium text-forest-dark mb-2">Phone Number</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors"
                placeholder="(616) 555-0123"
              />
            </div>
            
            <div>
              <label for="businessType" class="block text-sm font-medium text-forest-dark mb-2">Business Type</label>
              <select 
                id="businessType" 
                name="businessType"
                class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors"
              >
                <option value="">Select your business type</option>
                <option value="landscape-contractor">Landscape Contractor</option>
                <option value="wholesale-reseller">Wholesale Reseller</option>
                <option value="garden-store">Garden Store Retailer</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div class="flex-1 flex flex-col">
              <label for="message" class="block text-sm font-medium text-forest-dark mb-2">Message</label>
              <textarea 
                id="message" 
                name="message"
                rows="4"
                class="w-full px-4 py-3 border border-sage-light rounded-lg focus:ring-2 focus:ring-fresh-green focus:border-transparent transition-colors resize-none flex-1"
                placeholder="Tell us about your project or how we can help you..."
              ></textarea>
            </div>
            
            <button 
              type="submit"
              class="w-full bg-fresh-green hover:bg-forest-dark text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-300 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-fresh-green focus:ring-offset-2 cursor-pointer group mt-auto"
            >
              <span class="flex items-center justify-center">
                <span>Send Message</span>
                <Send class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform duration-300" />
              </span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer Section -->
<footer class="bg-forest-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Main Footer Content -->
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Logo and Brand -->
      <div class="text-center md:text-left">
        <div class="flex justify-center md:justify-start mb-4">
          <img 
            src="/images/logos/logo-light.png" 
            alt="Mill Creek Farm Perennials Logo" 
            class="h-12 w-auto"
          />
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">
          Mill Creek Farm Perennials
        </h3>
        <p class="text-white/70 text-sm">
          We Grow With You!
        </p>
      </div>
      
      <!-- Contact Info -->
      <div class="text-center md:text-left">
        <h4 class="text-sm font-semibold text-fresh-green mb-3 uppercase tracking-wide">Contact</h4>
        <div class="space-y-2 text-sm text-white/80">
          <p>4221 Bud Drive NE</p>
          <p>Comstock Park, MI 49321</p>
           <p>
             <a href="tel:+16168624331" class="text-fresh-green hover:text-white transition-colors cursor-pointer">
               (616) 862-4331
             </a>
           </p>
        </div>
      </div>
      
      <!-- Social -->
      <div class="text-center md:text-left">
        <h4 class="text-sm font-semibold text-fresh-green mb-3 uppercase tracking-wide">Follow Us</h4>
        <div class="flex justify-center md:justify-start space-x-3">
           <a 
             href="https://www.facebook.com/mcfperennials" 
             target="_blank" 
             rel="noopener noreferrer"
             class="inline-flex items-center justify-center w-10 h-10 bg-white/10 hover:bg-fresh-green text-white hover:text-white rounded-lg transition-all duration-300 cursor-pointer"
             aria-label="Visit our Facebook page"
           >
             <Facebook class="w-5 h-5" />
           </a>
           <a 
             href="https://maps.google.com/?q=4221+Bud+Drive+NE,+Comstock+Park,+MI+49321" 
             target="_blank" 
             rel="noopener noreferrer"
             class="inline-flex items-center justify-center w-10 h-10 bg-white/10 hover:bg-fresh-green text-white hover:text-white rounded-lg transition-all duration-300 cursor-pointer"
             aria-label="Find us on Google Maps"
           >
             <MapPin class="w-5 h-5" />
           </a>
        </div>
        <div class="mt-3 space-y-1">
          <a 
            href="https://www.facebook.com/mcfperennials" 
            target="_blank" 
            rel="noopener noreferrer"
            class="block text-white/70 hover:text-fresh-green text-sm transition-colors cursor-pointer"
          >
            Facebook Page
          </a>
          <a 
            href="https://maps.google.com/?q=4221+Bud+Drive+NE,+Comstock+Park,+MI+49321" 
            target="_blank" 
            rel="noopener noreferrer"
            class="block text-white/70 hover:text-fresh-green text-sm transition-colors cursor-pointer"
          >
            Google Maps
          </a>
        </div>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-2 md:space-y-0">
        <p class="text-white/60 text-sm">
          © 2024 Mill Creek Farm Perennials. All rights reserved.
        </p>
        <p class="text-white/60 text-sm">
          Over 30 years of nursery excellence
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  // Intersection Observer for fade-in animations
  function initFadeInAnimations() {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-slide-up');
        }
      });
    }, observerOptions);

    // Observe all fade-in elements
    const fadeElements = document.querySelectorAll('.fade-in-slide-up');
    fadeElements.forEach(el => {
      observer.observe(el);
    });
  }

  // Initialize animations when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFadeInAnimations);
  } else {
    initFadeInAnimations();
  }
</script>

<style>
  /* Fade in slide up animation */
  .fade-in-slide-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fade-in-slide-up.animate-fade-in-slide-up {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered animation delays */
  .fade-in-slide-up:nth-child(1) { animation-delay: 0s; }
  .fade-in-slide-up:nth-child(2) { animation-delay: 0.2s; }
  .fade-in-slide-up:nth-child(3) { animation-delay: 0.4s; }
  .fade-in-slide-up:nth-child(4) { animation-delay: 0.6s; }
  .fade-in-slide-up:nth-child(5) { animation-delay: 0.8s; }
</style>
