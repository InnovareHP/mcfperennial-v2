---
// Featured Section Component
---

<section id="featured" class="py-20 bg-sage-light/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-forest-dark mb-4">
        Featured Agricultural Solutions
      </h2>
      <p class="text-xl text-forest-dark/80 max-w-3xl mx-auto">
        Discover some of our most successful farming projects and the impact they've made on agricultural operations.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Featured Project 1 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden hover:shadow-xl transition-shadow border border-sage">
        <div class="bg-sage-light h-48 flex items-center justify-center">
          <span class="text-forest-dark/60">Smart Irrigation System</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Smart Irrigation System</h3>
          <p class="text-forest-dark/80 mb-4">
            An intelligent irrigation solution that increased crop yield by 40% while reducing water usage by 25%.
          </p>
          <a href="#" class="text-fresh-green font-semibold hover:text-fresh-green/80 flex items-center">
            View Project <span class="ml-1">→</span>
          </a>
        </div>
      </div>
      
      <!-- Featured Project 2 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden hover:shadow-xl transition-shadow border border-sage">
        <div class="bg-sage-light h-48 flex items-center justify-center">
          <span class="text-forest-dark/60">Crop Monitoring App</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Crop Monitoring App</h3>
          <p class="text-forest-dark/80 mb-4">
            A comprehensive mobile application that helps farmers track crop health and optimize farming practices.
          </p>
          <a href="#" class="text-fresh-green font-semibold hover:text-fresh-green/80 flex items-center">
            View Project <span class="ml-1">→</span>
          </a>
        </div>
      </div>
      
      <!-- Featured Project 3 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden hover:shadow-xl transition-shadow border border-sage">
        <div class="bg-sage-light h-48 flex items-center justify-center">
          <span class="text-forest-dark/60">Farm Management Platform</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Farm Management Platform</h3>
          <p class="text-forest-dark/80 mb-4">
            A scalable farm management system that handles multiple operations with 99.9% uptime and real-time monitoring.
          </p>
          <a href="#" class="text-fresh-green font-semibold hover:text-fresh-green/80 flex items-center">
            View Project <span class="ml-1">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
