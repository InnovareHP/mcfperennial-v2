---
// Our Team Section Component
---

<section id="team" class="py-20 bg-sage-light/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-forest-dark mb-4">
        Meet Our Agricultural Team
      </h2>
      <p class="text-xl text-forest-dark/80 max-w-3xl mx-auto">
        Our talented team of agricultural professionals is dedicated to delivering exceptional farming solutions for every project.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Team Member 1 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden text-center border border-sage hover:shadow-xl transition-shadow">
        <div class="bg-sage-light h-64 flex items-center justify-center">
          <span class="text-forest-dark/60">Agricultural Expert Photo</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Dr. Sarah Green</h3>
          <p class="text-fresh-green font-medium mb-3">Agricultural Director & Founder</p>
          <p class="text-forest-dark/80 text-sm">
            With over 15 years of experience in agricultural technology, Sarah leads our vision for sustainable farming solutions.
          </p>
        </div>
      </div>
      
      <!-- Team Member 2 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden text-center border border-sage hover:shadow-xl transition-shadow">
        <div class="bg-sage-light h-64 flex items-center justify-center">
          <span class="text-forest-dark/60">Agricultural Expert Photo</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Marcus Field</h3>
          <p class="text-fresh-green font-medium mb-3">Lead Agricultural Engineer</p>
          <p class="text-forest-dark/80 text-sm">
            Marcus brings expertise in precision agriculture and IoT farming solutions, leading our technical development team.
          </p>
        </div>
      </div>
      
      <!-- Team Member 3 -->
      <div class="bg-white rounded-natural shadow-natural overflow-hidden text-center border border-sage hover:shadow-xl transition-shadow">
        <div class="bg-sage-light h-64 flex items-center justify-center">
          <span class="text-forest-dark/60">Agricultural Expert Photo</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-forest-dark mb-2">Elena Harvest</h3>
          <p class="text-fresh-green font-medium mb-3">Agricultural Solutions Designer</p>
          <p class="text-forest-dark/80 text-sm">
            Elena ensures every agricultural solution has an intuitive, farmer-friendly design that maximizes productivity.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
