---
// Our Team Section Component
---

<section id="team" class="py-20 bg-stone-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-forest-dark mb-4">
        Meet Our Agricultural Team
      </h2>
      <p class="text-xl text-forest-dark/80 max-w-3xl mx-auto">
        Our passionate team of experts brings over fifty years of combined experience in nursery operations, delivering quality service and products to our partners.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Roy Gingrich, Owner/Founder -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden text-center border border-gray-200 hover:shadow-xl transition-shadow">
        <div class="h-80 bg-cover bg-center relative" style="background-image: url('/images/team/team-1.png');">
          <div class="absolute inset-0 bg-black/20"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-forest-dark mb-2">Roy Gingrich</h3>
          <p class="text-fresh-green font-medium mb-3">Owner/Founder</p>
          <p class="text-forest-dark/80 text-sm">
            Founder and owner of Mill Creek Farm Perennials, bringing decades of experience in nursery operations and plant cultivation.
          </p>
        </div>
      </div>
      
      <!-- Adam Schaafsma, Production Manager -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden text-center border border-gray-200 hover:shadow-xl transition-shadow">
        <div class="h-80 bg-cover bg-center relative" style="background-image: url('/images/team/team-3.png');">
          <div class="absolute inset-0 bg-black/20"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-forest-dark mb-2">Adam Schaafsma</h3>
          <p class="text-fresh-green font-medium mb-3">Production Manager</p>
          <p class="text-forest-dark/80 text-sm">
            Oversees daily production operations, ensuring quality and efficiency in our nursery growing processes.
          </p>
        </div>
      </div>
      
      <!-- Autumn Rose, Nursery Manager -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden text-center border border-gray-200 hover:shadow-xl transition-shadow">
        <div class="h-80 bg-cover bg-center relative" style="background-image: url('/images/team/team-4.png');">
          <div class="absolute inset-0 bg-black/20"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-forest-dark mb-2">Autumn Rose</h3>
          <p class="text-fresh-green font-medium mb-3">Nursery Manager</p>
          <p class="text-forest-dark/80 text-sm">
            Manages nursery operations and plant care, ensuring the health and quality of our perennial inventory.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
