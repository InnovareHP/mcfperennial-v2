---
// Reusable Button Component
interface Props {
  href: string;
  text: string;
  variant?: 'primary' | 'secondary';
  showArrow?: boolean;
}

const { href, text, variant = 'primary', showArrow = true } = Astro.props;

const buttonClasses = variant === 'primary'
  ? 'group inline-flex items-center justify-center bg-fresh-green hover:bg-emerald-600 text-white hover:text-white font-bold py-4 px-10 rounded-full transition-all duration-500 transform hover:scale-110 hover:shadow-2xl cursor-pointer border-2 border-fresh-green hover:border-emerald-600 shadow-lg hover:shadow-emerald-500/30'
  : 'group inline-flex items-center justify-center bg-forest-dark hover:bg-fresh-green text-white hover:text-white font-bold py-4 px-10 rounded-full transition-all duration-500 transform hover:scale-110 hover:shadow-2xl cursor-pointer border-2 border-forest-dark hover:border-fresh-green shadow-lg';
---

<a href={href} class={buttonClasses}>
  <span class="relative z-10">{text}</span>
  {showArrow && (
    <svg class="w-5 h-5 ml-3 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  )}
</a>
